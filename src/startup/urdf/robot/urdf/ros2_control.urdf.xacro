<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="robot_ros2_control" params="robot_backend">

  <ros2_control name="RobotSystem" type="system">
    <hardware>
      <xacro:if value="${robot_backend == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${robot_backend == 'mock'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${robot_backend == 'serial'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
    </hardware>

    <xacro:macro name="configure_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:configure_joint joint_name="front_left_wheel_joint" />
    <xacro:configure_joint joint_name="front_right_wheel_joint" />
    <xacro:configure_joint joint_name="rear_left_wheel_joint" />
    <xacro:configure_joint joint_name="rear_right_wheel_joint" />
    <xacro:configure_joint joint_name="front_arm_joint" />
    <xacro:configure_joint joint_name="rear_arm_joint" />
    <xacro:configure_joint joint_name="front_drum_joint" />
    <xacro:configure_joint joint_name="rear_drum_joint" />
  </ros2_control>

</xacro:macro>
</robot>
