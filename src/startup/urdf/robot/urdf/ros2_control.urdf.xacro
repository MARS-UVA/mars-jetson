<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="robot_ros2_control" params="robot_backend serial_port canivore_config:=''">

  <!-- CANivore settings (CAN IDs, gear ratios, ...) live in config/canivore.yaml. Only loaded
       for the canivore backend, so the other backends don't need the file. -->
  <xacro:property name="canivore_cfg"
    value="${xacro.load_yaml(canivore_config) if robot_backend == 'canivore' else None}"/>

  <!-- Emits <param name="key"> only if canivore.yaml sets it; otherwise the plugin default is used. -->
  <xacro:macro name="canivore_hw_param" params="key">
    <xacro:if value="${key in canivore_cfg}">
      <param name="${key}">${canivore_cfg[key]}</param>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="canivore_joint_param" params="joint_name key">
    <xacro:property name="joint_cfg" value="${canivore_cfg['joints'].get(joint_name, dict())}"/>
    <xacro:if value="${key in joint_cfg}">
      <param name="${key}">${joint_cfg[key]}</param>
    </xacro:if>
  </xacro:macro>

  <ros2_control name="RobotSystem" type="system">
    <hardware>
      <xacro:if value="${robot_backend == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${robot_backend == 'mock'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${robot_backend == 'serial'}">
        <plugin>robot_serial_hardware/RobotSerialHardware</plugin>
        <param name="port">${serial_port}</param>
        <param name="baudrate">2000000</param>
      </xacro:if>
      <xacro:if value="${robot_backend == 'canivore'}">
        <plugin>canivore_hardware/CanivoreHardware</plugin>
        <xacro:canivore_hw_param key="canbus"/>
        <xacro:canivore_hw_param key="feed_timeout_ms"/>
        <xacro:canivore_hw_param key="enable_foc"/>
        <xacro:canivore_hw_param key="status_frequency_hz"/>
        <xacro:canivore_hw_param key="feedback_publish_hz"/>
        <xacro:canivore_hw_param key="position_publish_hz"/>
        <xacro:canivore_hw_param key="activation_timeout_s"/>
      </xacro:if>
    </hardware>

    <xacro:macro name="configure_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:if value="${robot_backend == 'canivore'}">
          <xacro:canivore_joint_param joint_name="${joint_name}" key="can_id"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="gear_ratio"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="inverted"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="neutral_mode"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="max_velocity"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="stator_current_limit"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="supply_current_limit"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="kP"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="kS"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="kV"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="initial_position"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="min_position"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="max_position"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="feedback_angle_start"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="feedback_angle_end"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="feedback_output_start"/>
          <xacro:canivore_joint_param joint_name="${joint_name}" key="feedback_output_end"/>
        </xacro:if>
      </joint>
    </xacro:macro>

    <xacro:configure_joint joint_name="front_left_wheel_joint" />
    <xacro:configure_joint joint_name="front_right_wheel_joint" />
    <xacro:configure_joint joint_name="rear_left_wheel_joint" />
    <xacro:configure_joint joint_name="rear_right_wheel_joint" />
    <xacro:configure_joint joint_name="front_arm_joint" />
    <xacro:configure_joint joint_name="rear_arm_joint" />
    <xacro:configure_joint joint_name="front_drum_joint" />
    <xacro:configure_joint joint_name="rear_drum_joint" />

    <sensor name="unilidar_imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

</xacro:macro>
</robot>
