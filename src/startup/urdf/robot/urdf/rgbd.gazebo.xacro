<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Functional RGB-D approximation, not a model of RealSense stereo/IMU. -->
  <xacro:macro name="rgbd_camera" params="parent name xyz yaw">
    <link name="${name}_link">
      <inertial>
        <mass value="0.075"/>
        <inertia ixx="0.000056" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000056"/>
      </inertial>
      <visual>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="rgbd_material"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
    </link>
    <joint name="${name}_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <!-- Mount on either side of the chassis; tilt down 15 degrees. -->
      <origin xyz="${xyz}" rpy="0 ${pi / 12} ${yaw}"/>
    </joint>
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <gazebo reference="${name}_link">
      <sensor name="${name}_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/${name}</topic>
        <gz_frame_id>${name}_optical_frame</gz_frame_id>
        <camera>
          <!-- Shared RGB/depth geometry; these are simulation defaults. -->
          <horizontal_fov>${87 * pi / 180}</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>10.0</far></clip>
          <depth_camera>
            <clip><near>0.1</near><far>10.0</far></clip>
          </depth_camera>
          <camera_info_topic>/${name}/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
