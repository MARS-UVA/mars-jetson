<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arena">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- A global light source -->

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- apriltag localization board (start) -->
    <include>
      <uri>model://apriltag_board</uri>
      <pose>0.05 -2 0.34 0 1.57 0</pose>
    </include>

    <!-- arena frame boundary 
    Boundary: 6.88 m by 5 m (Kennedy Space Center Arena)
    (See model.sdf in arena_frame folder)
    -->
    <include>
      <uri>model://arena_frame_nasa</uri>
      <pose frame=''>0 0 0 0 -0 0</pose>
    </include>

<!-- Coordinates follow the supplied arena diagram, with y shifted by -2.5 m.
         Excavation: x=0..2.5. Obstacle zone: x=2.5..6.88.
         Starting zone (assumed 2 m square): x=0..2, y=-2.5..-0.5.
         Construction zone: x=3.88..6.88, y=-2.5..-1.0.
         Rock placement is approximate; no craters or berm are modeled yet. -->

    <!--
      INSERT OBSTACLES HERE
    -->
      
    <include>
      <uri>model://rock_rough</uri>
      <name>rock_rough_3</name>
      <pose>2.3 -1.8 0 0 0 1.12</pose>
    </include>

    <include>
      <uri>model://rock_small</uri>
      <name>rock_small_2</name>
      <pose>1.6 0.2 0 0 0 2.56</pose>
    </include>

    <include>
      <uri>model://rock_rough</uri>
      <name>rock_rough_2</name>
      <pose>5.3 -0.2 0 0 0 1.98</pose>
    </include>

    <include>
      <uri>model://rock_rough</uri>
      <name>rock_rough_1</name>
      <pose>2.4 2.2 0 0 0 1.54</pose>
    </include>

    <include>
      <uri>model://rock_small</uri>
      <name>rock_small_1</name>
      <pose>0.5 1.8 0 0 0 1.12</pose>
    </include>

    <include>
      <uri>model://rock_huge</uri>
      <name>rock_huge_1</name>
      <pose>3.5 1.3 0 0 0 1.12</pose>
    </include>

    <include>
      <uri>model://rock_small</uri>
      <name>rock_small_3</name>
      <pose>3.5 -2.1 0 0 0 1.12</pose>
    </include>
    
    <!-- Own physics settings to speed up simulation -->
    <physics type='dart'> 
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>
  </world>
</sdf>
