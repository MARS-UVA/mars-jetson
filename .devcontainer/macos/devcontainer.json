{
    "name": "ROS 2 Development — macOS",
    "privileged": true,
    "remoteUser": "vscode",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "../..",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "initializeCommand": "docker network inspect mars-dev >/dev/null 2>&1 || docker network create mars-dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "CONTROL_STATION_IP": "mars-control-station",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "version": "latest",
            "noVNC": "true",
            "webPort": "6080",
            "vncPort": "5901"
        }
    },
    "forwardPorts": [
        6080
    ],
    "portsAttributes": {
        "6080": {
            "label": "ROS Desktop",
            "onAutoForward": "openBrowser"
        }
    },
    "postCreateCommand": "sudo apt update && sudo rosdep update && sudo rosdep install --from-paths src --ignore-src -y",
    "runArgs": [
        "--network=mars-dev",
        "--network-alias=mars-jetson",
        "-p",
        "8080:8080/udp"
    ]
}
