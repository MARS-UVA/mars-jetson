From 52e95cbbd6d3331674ca0dbde402bb834c5700b6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 22:35:11 +0000
Subject: [PATCH] AprilTagGate: clear stale detections and time out when no tag
 is seen

- Reset the updated flag at the start of each call so only detections
  that arrive during the call are forwarded.
- New detection_timeout parameter (default 2.0 s): a call ends if no new
  detection arrives within that time, instead of waiting forever.
  success stays False unless at least one detection was forwarded.
---
 src/robot_perception/robot_perception/AprilTagGate.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/robot_perception/robot_perception/AprilTagGate.py b/src/robot_perception/robot_perception/AprilTagGate.py
index 783b0a5..56f11a5 100644
--- a/src/robot_perception/robot_perception/AprilTagGate.py
+++ b/src/robot_perception/robot_perception/AprilTagGate.py
@@ -31,6 +31,7 @@ class AprilTagGateNode(Node):
         self.updated = False
         self.data_lock = threading.Lock()
         self.declare_parameter("send_detections", 100)
+        self.declare_parameter("detection_timeout", 2.0)
         
         self.get_logger().info("April Tag Service Initialized")
         
@@ -53,14 +54,23 @@ class AprilTagGateNode(Node):
     def AprilTagService_callback(self,request,responce):
         
         totalCall = self.get_parameter("send_detections").get_parameter_value().integer_value
+        timeout = self.get_parameter("detection_timeout").get_parameter_value().double_value
+
+        # Only forward detections that arrive during this call.
+        with self.data_lock:
+            self.updated = False
         
         for i in range(1, totalCall):
             
             #waiting for subscriber to update with new tag detections
+            deadline = time.monotonic() + timeout
             while True:
                 with self.data_lock:
                     if self.updated:
                         break
+                if time.monotonic() >= deadline:
+                    self.get_logger().info(f"No AprilTag detections for {timeout} s; ending call")
+                    return responce
                 time.sleep(0.01)
                 
                 
