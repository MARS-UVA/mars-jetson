+"""Bench test for canivore_hardware, separate from the robot's own launch files.
+
+    ros2 launch canivore_hardware_bench bench.launch.py
+    ros2 launch canivore_hardware_bench bench.launch.py hardware_config:=/path/to/my.yaml
+
+Starts robot_state_publisher, the controller manager with canivore_hardware, and the same three
+controllers the robot uses. Then run `ros2 run canivore_hardware_bench drive_check.py`.
+"""
+
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument
+from launch.substitutions import Command, LaunchConfiguration, PathJoinSubstitution
+from launch_ros.actions import Node
+from launch_ros.parameter_descriptions import ParameterValue
+from launch_ros.substitutions import FindPackageShare
+
+
+def generate_launch_description():
+    pkg = FindPackageShare('canivore_hardware_bench')
+
+    robot_description = ParameterValue(Command([
+        'xacro ', PathJoinSubstitution([pkg, 'urdf', 'bench.urdf.xacro']),
+        ' hardware_config:=', LaunchConfiguration('hardware_config'),
+    ]), value_type=str)
+    controllers = PathJoinSubstitution([pkg, 'config', 'bench_controllers.yaml'])
+
+    def spawner(name):
+        return Node(
+            package='controller_manager', executable='spawner', output='screen',
+            arguments=[name, '--controller-manager', '/controller_manager',
+                       '--param-file', controllers],
+        )
+
+    return LaunchDescription([
+        DeclareLaunchArgument(
+            'hardware_config',
+            default_value=PathJoinSubstitution([pkg, 'config', 'bench_hardware.yaml']),
+            description='YAML with CAN IDs and settings for each joint',
+        ),
+        Node(
+            package='robot_state_publisher', executable='robot_state_publisher', output='screen',
+            parameters=[{'robot_description': robot_description}],
+        ),
+        Node(
+            package='controller_manager', executable='ros2_control_node', output='screen',
+            parameters=[{'robot_description': robot_description}, controllers],
+        ),
+        spawner('joint_state_broadcaster'),
+        spawner('base_controller'),
+        spawner('arm_drum_controller'),
+    ])
