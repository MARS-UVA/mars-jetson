+++ b/src/canivore_hardware_bench/scripts/drive_check.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Send fixed commands for a few seconds, then print every joint's position and velocity.
+
+    ros2 run canivore_hardware_bench drive_check.py
+    ros2 run canivore_hardware_bench drive_check.py --linear 0.2 --angular 0 --arms 0 0 --drums 0.5 0.5
+
+With no hardware connected, the wheel velocities should match the diff-drive math for the
+commanded twist, and the arm/drum velocities should equal the commands.
+"""
+
+import argparse
+import time
+
+import rclpy
+from geometry_msgs.msg import TwistStamped
+from rclpy.node import Node
+from sensor_msgs.msg import JointState
+from std_msgs.msg import Float64MultiArray
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--linear', type=float, default=0.3, help='m/s')
+    parser.add_argument('--angular', type=float, default=0.5, help='rad/s')
+    parser.add_argument('--arms', type=float, nargs=2, default=[-0.5, 0.5], metavar=('FRONT', 'REAR'), help='rad/s')
+    parser.add_argument('--drums', type=float, nargs=2, default=[1.0, -1.0], metavar=('FRONT', 'REAR'), help='rad/s')
+    parser.add_argument('--seconds', type=float, default=4.0)
+    args, _ = parser.parse_known_args()
+
+    rclpy.init()
+    node = Node('drive_check')
+    latest = {}
+    node.create_subscription(JointState, '/joint_states', lambda m: latest.update(js=m), 10)
+    cmd_vel = node.create_publisher(TwistStamped, '/base_controller/cmd_vel', 10)
+    arm_drum = node.create_publisher(Float64MultiArray, '/arm_drum_controller/commands', 10)
+
+    end = time.time() + args.seconds
+    while time.time() < end:
+        twist = TwistStamped()
+        twist.header.stamp = node.get_clock().now().to_msg()
+        twist.twist.linear.x = args.linear
+        twist.twist.angular.z = args.angular
+        cmd_vel.publish(twist)
+        # Order matches arm_drum_controller's joint list: front arm, rear arm, front drum, rear drum
+        arm_drum.publish(Float64MultiArray(data=[*args.arms, *args.drums]))
+        rclpy.spin_once(node, timeout_sec=0.05)
+
+    # Send zeros so the arms and drums stop: arm_drum_controller holds its last command.
+    for _ in range(5):
+        arm_drum.publish(Float64MultiArray(data=[0.0] * 4))
+        time.sleep(0.02)
+
+    if 'js' not in latest:
+        print('No /joint_states received. Is the bench launch running?')
+    else:
+        js = latest['js']
+        for name, pos, vel in zip(js.name, js.position, js.velocity):
+            print(f'{name:25s} position {pos:8.3f} rad   velocity {vel:7.3f} rad/s')
+    node.destroy_node()
+    rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    main()
