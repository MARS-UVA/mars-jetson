+# Same controllers as the robot (startup/config/controllers.yaml), copied so the bench doesn't
+# depend on the startup package.
+controller_manager:
+  ros__parameters:
+    update_rate: 500  # Hz
+
+    joint_state_broadcaster:
+      type: joint_state_broadcaster/JointStateBroadcaster
+
+    base_controller:
+      type: diff_drive_controller/DiffDriveController
+
+    arm_drum_controller:
+      type: velocity_controllers/JointGroupVelocityController
+
+base_controller:
+  ros__parameters:
+    left_wheel_names: [front_left_wheel_joint, rear_left_wheel_joint]
+    right_wheel_names: [front_right_wheel_joint, rear_right_wheel_joint]
+    wheel_separation: 0.4318
+    wheel_radius: 0.1778
+    base_frame_id: base_link
+    enable_odom_tf: false
+    publish_rate: 50.0
+    cmd_vel_timeout: 0.5
+    open_loop: true
+    linear.x.has_velocity_limits: true
+    linear.x.max_velocity: 0.80
+    linear.x.min_velocity: -0.80
+    angular.z.has_velocity_limits: true
+    angular.z.max_velocity: 2.4
+    angular.z.min_velocity: -2.4
+
+arm_drum_controller:
+  ros__parameters:
+    joints: [front_arm_joint, rear_arm_joint, front_drum_joint, rear_drum_joint]
