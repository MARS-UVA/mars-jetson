@@ -0,0 +1,23 @@
+# Bench settings for canivore_hardware. Used only by canivore_hardware_bench, never by the robot.
+#
+# can_id: -1 means "not connected": the joint echoes its command back as its state, so the
+# whole stack runs with no hardware. To bench-test a motor, give just that joint its real CAN
+# ID (from Phoenix Tuner X) and leave the rest at -1.
+#
+# Keys left out fall back to the plugin's defaults (see canivore_hardware/README.md).
+
+canbus: "*"              # "*" = any CANivore found
+feed_timeout_ms: 100
+enable_foc: false
+
+joints:
+  front_left_wheel_joint:  {can_id: -1, max_velocity: 10.0}
+  front_right_wheel_joint: {can_id: -1, max_velocity: 10.0}
+  rear_left_wheel_joint:   {can_id: -1, max_velocity: 10.0}
+  rear_right_wheel_joint:  {can_id: -1, max_velocity: 10.0}
+  front_drum_joint:        {can_id: -1, max_velocity: 10.0, neutral_mode: coast}
+  rear_drum_joint:         {can_id: -1, max_velocity: 10.0, neutral_mode: coast}
+  # Arm limits match the URDF (-1.2 to 0.2 rad, 2 rad/s). On real hardware, also set
+  # initial_position (the arm angle at power-on) or the soft limits will be in the wrong place.
+  front_arm_joint: {can_id: -1, max_velocity: 2.0, min_position: -1.2, max_position: 0.2}
+  rear_arm_joint:  {can_id: -1, max_velocity: 2.0, min_position: -1.2, max_position: 0.2}
