From d35a64b756d7865a81a7311c8fc9da8d6b54844c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 23:05:53 +0000
Subject: [PATCH] LocalizeToAprilTags: check ahead, then +45 deg, then -45 deg

Replace the one-direction 36 deg steps with headings measured from where
the search started: straight ahead, +45 deg, then a 90 deg swing to -45 deg.
Measuring from the start keeps turn errors from adding up. Headings are a
constructor argument. Only the front camera detects tags.
---
 .../states/localize_to_apriltags.py           | 36 ++++++++++-------
 .../test/test_localize_to_apriltags.py        | 40 +++++++++++++++----
 2 files changed, 53 insertions(+), 23 deletions(-)

diff --git a/src/robot_super_intelligence/robot_super_intelligence/states/localize_to_apriltags.py b/src/robot_super_intelligence/robot_super_intelligence/states/localize_to_apriltags.py
index 2d47c5a..9259111 100644
--- a/src/robot_super_intelligence/robot_super_intelligence/states/localize_to_apriltags.py
+++ b/src/robot_super_intelligence/robot_super_intelligence/states/localize_to_apriltags.py
@@ -1,8 +1,10 @@
 """LocalizeToAprilTags: feed AprilTag sightings to RTAB-Map, turning to find one.
 
 At each heading the gate is called. It forwards detections to RTAB-Map and
-answers success only if it saw a tag; otherwise the robot turns in place by
-one step (a navigation goal at its current position) and tries again.
+answers success only if it saw a tag; otherwise the robot turns in place to
+the next heading (a navigation goal at its starting position) and tries
+again. By default it checks straight ahead, then 45 deg to one side, then
+45 deg to the other. Only the front camera detects tags.
 """
 
 import math
@@ -31,27 +33,29 @@ def rotated(pose, angle):
 class LocalizeToAprilTags(State):
     outcomes = frozenset({Outcome.APRILTAG_LOCALIZED, Outcome.APRILTAG_DETECTION_FAILED})
 
-    def __init__(self, apriltags, step_rad=math.radians(36), max_turns=3,
+    def __init__(self, apriltags, headings_rad=(math.radians(45), math.radians(-45)),
                  gate_timeout_sec=15.0):
-        """Check up to max_turns + 1 headings, step_rad apart.
+        """Check straight ahead, then each heading in headings_rad.
 
+        Headings are relative to the robot's heading when the search starts.
         gate_timeout_sec only guards against a gate that never answers; it
         must exceed a full gate batch (the gate itself gives up after about
         2 s without a tag).
         """
         if apriltags is None:
             raise ValueError('An AprilTag helper is required')
-        if not (math.isfinite(step_rad) and math.isfinite(gate_timeout_sec)
-                and gate_timeout_sec > 0 and max_turns >= 0):
+        headings_rad = tuple(headings_rad)
+        if not (all(math.isfinite(h) for h in headings_rad)
+                and math.isfinite(gate_timeout_sec) and gate_timeout_sec > 0):
             raise ValueError('Invalid localization settings')
         self.apriltags = apriltags
-        self.step_rad = step_rad
-        self.max_turns = max_turns
+        self.headings_rad = headings_rad
         self.gate_timeout_sec = gate_timeout_sec
         self.enter()
 
     def enter(self):
         self.turns = 0
+        self.origin = None
         self.active = False
 
     def start(self, dispatch, on_complete):
@@ -72,19 +76,21 @@ class LocalizeToAprilTags(State):
             return
         if saw_tag:
             self.finish(Outcome.APRILTAG_LOCALIZED)
-        elif self.turns >= self.max_turns:
+        elif self.turns >= len(self.headings_rad):
             self.finish(Outcome.APRILTAG_DETECTION_FAILED)
         else:
             self.turn()
 
     def turn(self):
-        pose = self.apriltags.current_pose()
-        if pose is None:
-            self.finish(Outcome.APRILTAG_DETECTION_FAILED)
-            return
+        # Remember where the search started; every heading is measured from it.
+        if self.origin is None:
+            self.origin = self.apriltags.current_pose()
+            if self.origin is None:
+                self.finish(Outcome.APRILTAG_DETECTION_FAILED)
+                return
+        target = rotated(self.origin, self.headings_rad[self.turns])
         self.dispatch(ManageRobot.Goal(operation=ManageRobot.Goal.NAVIGATE,
-                                       target_pose=rotated(pose, self.step_rad)),
-                      self.turned)
+                                       target_pose=target), self.turned)
 
     def turned(self, outcome):
         if not self.active:
diff --git a/src/robot_super_intelligence/test/test_localize_to_apriltags.py b/src/robot_super_intelligence/test/test_localize_to_apriltags.py
index bd62d2d..bf9c139 100644
--- a/src/robot_super_intelligence/test/test_localize_to_apriltags.py
+++ b/src/robot_super_intelligence/test/test_localize_to_apriltags.py
@@ -71,24 +71,44 @@ def test_tag_in_view_localizes_without_turning():
     complete.assert_called_once_with(Outcome.APRILTAG_LOCALIZED)
 
 
-def test_turns_one_step_per_miss_until_a_tag_is_seen():
+def test_checks_ahead_then_45_one_way_then_45_the_other():
     tags = FakeTags([False, False, True])
     goals, complete = run(LocalizeToAprilTags(tags), ['SUCCESS', 'SUCCESS'])
     assert len(goals) == 2 and len(tags.calls) == 3
     for goal in goals:
         assert goal.operation == ManageRobot.Goal.NAVIGATE
         assert goal.target_pose.header.frame_id == 'map'
-        assert yaw(goal.target_pose) == pytest.approx(math.radians(36))
+        assert (goal.target_pose.pose.position.x, goal.target_pose.pose.position.y) == (1.0, 2.0)
+    assert [math.degrees(yaw(g.target_pose)) for g in goals] == pytest.approx([45, -45])
     complete.assert_called_once_with(Outcome.APRILTAG_LOCALIZED)
 
 
 def test_gives_up_after_the_last_heading():
-    tags = FakeTags([False] * 4)
-    goals, complete = run(LocalizeToAprilTags(tags, max_turns=3), ['SUCCESS'] * 3)
-    assert len(goals) == 3 and len(tags.calls) == 4
+    tags = FakeTags([False] * 3)
+    goals, complete = run(LocalizeToAprilTags(tags), ['SUCCESS'] * 2)
+    assert len(goals) == 2 and len(tags.calls) == 3
     complete.assert_called_once_with(Outcome.APRILTAG_DETECTION_FAILED)
 
 
+def test_headings_are_measured_from_where_the_search_started():
+    # After the first turn the robot stops 10 deg short; the second target
+    # must still be -45 deg from the start, not -45 deg from where it stopped.
+    tags = FakeTags([False, False, False])
+    poses = [pose(heading=math.radians(90)), pose(heading=math.radians(125))]
+    tags.current_pose = lambda: poses.pop(0)
+    goals, complete = run(LocalizeToAprilTags(tags), ['SUCCESS'] * 2)
+    assert [math.degrees(yaw(g.target_pose)) for g in goals] == pytest.approx([135, 45])
+    assert len(poses) == 1  # the pose was looked up once, at the first turn
+
+
+def test_headings_can_be_configured():
+    tags = FakeTags([False, False, False, True])
+    headings = [math.radians(d) for d in (30, -30, 60)]
+    goals, complete = run(LocalizeToAprilTags(tags, headings_rad=headings), ['SUCCESS'] * 3)
+    assert [math.degrees(yaw(g.target_pose)) for g in goals] == pytest.approx([30, -30, 60])
+    complete.assert_called_once_with(Outcome.APRILTAG_LOCALIZED)
+
+
 def test_failed_turn_or_unknown_pose_fails():
     goals, complete = run(LocalizeToAprilTags(FakeTags([False])), ['CHILD_FAILED'])
     complete.assert_called_once_with(Outcome.APRILTAG_DETECTION_FAILED)
@@ -100,11 +120,13 @@ def test_failed_turn_or_unknown_pose_fails():
     complete.assert_called_once_with(Outcome.APRILTAG_DETECTION_FAILED)
 
 
-def test_enter_resets_the_turn_count_between_visits():
-    state = LocalizeToAprilTags(FakeTags([False, False, True, False, True]), max_turns=2)
+def test_enter_resets_the_search_between_visits():
+    tags = FakeTags([False, False, True, False, True])
+    state = LocalizeToAprilTags(tags)
     run(state, ['SUCCESS', 'SUCCESS'])
+    tags.pose_value = pose(heading=math.radians(-90))
     goals, complete = run(state, ['SUCCESS'])
-    assert len(goals) == 1
+    assert [math.degrees(yaw(g.target_pose)) for g in goals] == pytest.approx([-45])
     complete.assert_called_once_with(Outcome.APRILTAG_LOCALIZED)
 
 
@@ -133,6 +155,8 @@ def test_settings_are_validated():
         LocalizeToAprilTags(None)
     with pytest.raises(ValueError):
         LocalizeToAprilTags(FakeTags([]), gate_timeout_sec=0)
+    with pytest.raises(ValueError):
+        LocalizeToAprilTags(FakeTags([]), headings_rad=[float('nan')])
     assert LocalizeToAprilTags.outcomes == {
         Outcome.APRILTAG_LOCALIZED, Outcome.APRILTAG_DETECTION_FAILED}
 
