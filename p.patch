+<?xml version="1.0"?>
+<!-- Minimal robot for bench-testing canivore_hardware. Same joint names as the real robot, but
+     simple shapes and no dependency on the startup package. Not used by the robot itself. -->
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="canivore_bench">
+
+  <xacro:arg name="hardware_config" default="$(find canivore_hardware_bench)/config/bench_hardware.yaml"/>
+  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg hardware_config)')}"/>
+
+  <link name="base_link"/>
+
+  <!-- Links and joints -->
+  <xacro:macro name="wheel" params="name x y">
+    <link name="${name}"/>
+    <joint name="${name}_joint" type="continuous">
+      <parent link="base_link"/>
+      <child link="${name}"/>
+      <origin xyz="${x} ${y} 0"/>
+      <axis xyz="0 1 0"/>
+    </joint>
+  </xacro:macro>
+  <xacro:wheel name="front_left_wheel" x="0.2" y="0.2159"/>
+  <xacro:wheel name="front_right_wheel" x="0.2" y="-0.2159"/>
+  <xacro:wheel name="rear_left_wheel" x="-0.2" y="0.2159"/>
+  <xacro:wheel name="rear_right_wheel" x="-0.2" y="-0.2159"/>
+
+  <xacro:macro name="arm_and_drum" params="side x">
+    <link name="${side}_arm"/>
+    <joint name="${side}_arm_joint" type="revolute">
+      <parent link="base_link"/>
+      <child link="${side}_arm"/>
+      <origin xyz="${x} 0 0.1"/>
+      <axis xyz="0 1 0"/>
+      <limit lower="-1.2" upper="0.2" effort="1000" velocity="2.0"/>
+    </joint>
+    <link name="${side}_drum"/>
+    <joint name="${side}_drum_joint" type="continuous">
+      <parent link="${side}_arm"/>
+      <child link="${side}_drum"/>
+      <origin xyz="0.3 0 0"/>
+      <axis xyz="0 1 0"/>
+    </joint>
+  </xacro:macro>
+  <xacro:arm_and_drum side="front" x="0.3"/>
+  <xacro:arm_and_drum side="rear" x="-0.3"/>
+
+  <!-- ros2_control: every value comes from the yaml; keys left out use the plugin defaults -->
+  <xacro:macro name="hw_joint" params="name">
+    <xacro:property name="j" value="${cfg['joints'].get(name, dict())}"/>
+    <joint name="${name}">
+      <command_interface name="velocity"/>
+      <state_interface name="position"/>
+      <state_interface name="velocity"/>
+      <state_interface name="effort"/>
+      <xacro:if value="${'can_id' in j}"><param name="can_id">${j['can_id']}</param></xacro:if>
+      <xacro:if value="${'gear_ratio' in j}"><param name="gear_ratio">${j['gear_ratio']}</param></xacro:if>
+      <xacro:if value="${'inverted' in j}"><param name="inverted">${j['inverted']}</param></xacro:if>
+      <xacro:if value="${'neutral_mode' in j}"><param name="neutral_mode">${j['neutral_mode']}</param></xacro:if>
+      <xacro:if value="${'max_velocity' in j}"><param name="max_velocity">${j['max_velocity']}</param></xacro:if>
+      <xacro:if value="${'stator_current_limit' in j}"><param name="stator_current_limit">${j['stator_current_limit']}</param></xacro:if>
+      <xacro:if value="${'supply_current_limit' in j}"><param name="supply_current_limit">${j['supply_current_limit']}</param></xacro:if>
+      <xacro:if value="${'kP' in j}"><param name="kP">${j['kP']}</param></xacro:if>
+      <xacro:if value="${'kS' in j}"><param name="kS">${j['kS']}</param></xacro:if>
+      <xacro:if value="${'kV' in j}"><param name="kV">${j['kV']}</param></xacro:if>
+      <xacro:if value="${'initial_position' in j}"><param name="initial_position">${j['initial_position']}</param></xacro:if>
+      <xacro:if value="${'min_position' in j}"><param name="min_position">${j['min_position']}</param></xacro:if>
+      <xacro:if value="${'max_position' in j}"><param name="max_position">${j['max_position']}</param></xacro:if>
+    </joint>
+  </xacro:macro>
+
+  <ros2_control name="CanivoreBench" type="system">
+    <hardware>
+      <plugin>canivore_hardware/CanivoreHardware</plugin>
+      <param name="canbus">${cfg.get('canbus', '*')}</param>
+      <param name="feed_timeout_ms">${cfg.get('feed_timeout_ms', 100)}</param>
+      <param name="enable_foc">${cfg.get('enable_foc', False)}</param>
+    </hardware>
+    <xacro:hw_joint name="front_left_wheel_joint"/>
+    <xacro:hw_joint name="front_right_wheel_joint"/>
+    <xacro:hw_joint name="rear_left_wheel_joint"/>
+    <xacro:hw_joint name="rear_right_wheel_joint"/>
+    <xacro:hw_joint name="front_arm_joint"/>
+    <xacro:hw_joint name="rear_arm_joint"/>
+    <xacro:hw_joint name="front_drum_joint"/>
+    <xacro:hw_joint name="rear_drum_joint"/>
+  </ros2_control>
+</robot>

